# Runtime configuration for the pdf-inspector HTTP API.
# Install to /etc/pdf-inspector.env with mode 600 — it may hold the API key.
#
# Format: KEY=value, one per line, no quotes and no inline comments
# (both systemd's EnvironmentFile= and docker's --env-file read this file).

# --- Service settings (read inside the container) --------------------------

# Largest accepted upload, in MiB.
PDF_INSPECTOR_MAX_UPLOAD_MB=64

# How many PDFs are parsed at once. Defaults to the container's CPU count.
# Lower it to bound peak memory on small servers.
#PDF_INSPECTOR_MAX_CONCURRENCY=4

# When set, every /v1/* request must present this key as
# `Authorization: Bearer <key>` or `X-API-Key: <key>`. /health stays open.
# Generate one with: openssl rand -hex 32
#PDF_INSPECTOR_API_KEY=

# Log level: error, warn, info, debug, trace.
RUST_LOG=info

# Do NOT set PDF_INSPECTOR_BIND or PDF_INSPECTOR_PORT here: the container
# always listens on 0.0.0.0:8080 and the host port is chosen by the publish
# mapping below.

# --- Deployment settings (read by the systemd unit) ------------------------

# Image tag the service runs.
PDF_INSPECTOR_IMAGE=pdf-inspector:latest

# Container name.
PDF_INSPECTOR_CONTAINER=pdf-inspector

# Host interface and port published to clients. Use 127.0.0.1:8080 when a
# reverse proxy on the same host terminates TLS.
PDF_INSPECTOR_PUBLISH=0.0.0.0:8080
